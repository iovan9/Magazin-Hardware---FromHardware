<div id="watermark">Iovan<br>Razvan-Marian<br><small style="font-size: 1rem;">IP: <%= locals.ip %></small></div>

<header>
    <h1 class="text-reflexie" data-text="FromHardware">FromHardware</h1>

    <hgroup>
        <h2><i class="fa-solid fa-fan fa-spin" style="font-family: 'Font Awesome 6 Free' !important; font-weight: 900 !important; font-style: normal !important; color: var(--color-primary);"></i> Performanta extrema</h2>
        <p>Echipamente pentru gaming si productivitate</p>
    </hgroup>

    <a href="/resurse/imagini/sigla-mare.png" target="_blank">
        <img src="/resurse/imagini/sigla.png" alt="Sigla magazin" title="Apasa pentru versiunea marita" />
    </a>

    <nav id="meniu-principal">
        <input type="checkbox" id="hamburger-checkbox">
        <label id="hamburger-label" for="hamburger-checkbox">
            <div class="bara-hamburger"></div>
            <div class="bara-hamburger"></div>
            <div class="bara-hamburger"></div>
        </label>

        <ul class="meniu">
            <li style="display: flex; align-items: center; justify-content: center;">
                <div class="form-check form-switch mt-2 ms-3 d-inline-block">
                    <input class="form-check-input" type="checkbox" id="btn-tema" style="cursor: pointer;">
                    <label class="form-check-label" for="btn-tema" style="cursor: pointer;">
                        <i class="fa-solid fa-moon text-warning" id="icon-tema"></i>
                    </label>
                </div>
            </li>
            <li>
                <a href="/produse"><i class="fa-solid fa-microchip"></i> Produse</a>
                <ul class="submeniu">
                    <li><a href="/produse?categorie=toate">Toate produsele</a></li>

                    <% if (locals.categorii) { %>
                        <% for (let cat of locals.categorii) { %>
                            <li><a href="/produse?categorie=<%= cat %>"><%= cat.replace(/_/g, ' ') %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>
            <li><a href="/"><i class="fas fa-home"></i> <span class="text-meniu">Acasă</span></a></li>
            <li>
                <a href="/#z1"><i class="fas fa-microchip"></i> <span class="text-meniu">Componente</span></a>
                <ul class="submeniu">
                    <li><a href="/#z1">Procesoare</a></li>
                    <li><a href="/#z8">Memorie RAM</a></li>
                </ul>
            </li>
            <li>
                <a href="/#z4"><i class="fas fa-info-circle"></i> <span class="text-meniu">Informații</span></a>
                <ul class="submeniu">
                    <li><a href="/istoric">Istoric Magazin</a></li>
                    <li><a href="/galerie">Galerie Statică</a></li>
                </ul>
            </li>
            <li><a href="/#z2"><i class="fas fa-calendar-alt"></i> <span class="text-meniu">Evenimente</span></a></li>
        </ul>
    </nav>
</header>