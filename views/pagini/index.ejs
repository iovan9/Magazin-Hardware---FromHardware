<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head') %>
</head>
<body id="top">

<%- include('../fragmente/header') %>

<main>
    <% if (locals.oferta_activa && new Date().getTime() < locals.oferta_activa['data-finalizare']) { %>
        <div id="banner-oferta" class="alert alert-warning text-center shadow-sm" style="font-size: 1.2rem; border: 2px solid orange;">
            <i class="fa-solid fa-gift text-danger"></i> OFERTA SPECIALA!
            <strong style="color: red;"><%= locals.oferta_activa.reducere %>% REDUCERE</strong>
            la toate produsele din categoria <strong><%= locals.oferta_activa.categorie.replace(/_/g, ' ') %></strong>! <br>
            Expira in: <strong id="timer-oferta" data-finalizare="<%= locals.oferta_activa['data-finalizare'] %>" style="font-family: monospace; font-size: 1.5rem;">Calculare...</strong>
        </div>

        <script>
            function updateTimer() {
                let timerEl = document.getElementById("timer-oferta");
                if (!timerEl) return;
                let final = parseInt(timerEl.dataset.finalizare);
                let acum = new Date().getTime();
                let diferenta = final - acum;

                if (diferenta <= 0) {
                    document.getElementById("banner-oferta").style.display = "none";
                    return;
                }

                let min = Math.floor((diferenta / 1000 / 60) % 60);
                let sec = Math.floor((diferenta / 1000) % 60);

                if (diferenta <= 10000) {
                    timerEl.style.color = "red";
                    // Aici poti adauga si un sunet daca profa e pretentioasa, dar rosu e destul conform cerintei
                }

                timerEl.innerHTML = `${min}m ${sec}s`;
            }
            setInterval(updateTimer, 1000);
            updateTimer();
        </script>
    <% } %>
    <div class="alert alert-primary mt-4" role="alert">
        <strong>Verificare Bootstrap!</strong> Acest mesaj folosește schema noastră cromatică.
        <a href="/#z1" class="btn btn-secondary ms-3">Spre oferte</a>
    </div>

    <article id="z1">
        <h2><i class="fa-solid fa-bolt" style="font-family: 'Font Awesome 6 Free' !important; font-weight: 900 !important; font-style: normal !important; color: var(--color-highlight);"></i> Oferte curente</h2>
        <section>
            <h3>Procesoare si Memorie</h3>
            <p>Avem cele mai bune <b>procesoare</b> si <b>memorie RAM</b> pentru sistemul tau. <strong>Stocul se epuizeaza rapid, comanda acum!</strong></p>
            <figure>
                <picture>
                    <source srcset="/resurse/imagini/ryzen-mic.jpg" media="(max-width: 43.75rem)"/>
                    <source srcset="/resurse/imagini/ryzen-mediu.jpg" media="(max-width: 75rem)"/>
                    <img src="/resurse/imagini/ryzen-mediu.jpg" alt="Procesor Ryzen 7" title="AMD Ryzen 7 7800X3D la reducere" />
                </picture>
                <figcaption>Procesor AMD Ryzen 7 7800X3D (Versiunea Box)</figcaption>
            </figure>
        </section>
    </article>

    <section id="z2">
        <h2>Program Evenimente si Lansari</h2>
        <ul>
            <li><time datetime="2026-03-20T10:00">20 Martie, ora 10:00</time> - <b>Lansare RTX 5090</b></li>
            <li><time datetime="2026-04-05T14:00">5 Aprilie, ora 14:00</time> - <b>Lichidare stoc RAM</b></li>
        </ul>
    </section>

    <section id="z3">
        <h3>Statistici Magazin</h3>
        <div class="flex-container-stats">
            <p>Disponibilitate procesoare Intel: <meter value="15" min="0" max="100" low="20" high="80" optimum="90">15%</meter></p>
            <p>Satisfactia clientilor: <meter value="98" min="0" max="100" low="40" high="80" optimum="100">98%</meter></p>
            <blockquote>Alegerea unei surse de alimentare stabile este cel mai important pas.</blockquote>
            <details>
                <summary>Detalii Suplimentare Stoc</summary>
                <p>Verificam disponibilitatea componentelor zilnic.</p>
            </details>
        </div>
    </section>

    <section id="z4">
        <h2>Informatii si Detalii</h2>
        <h3>Calculul puterii necesare (Sursa)</h3>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <mrow><mi>P</mi><mo>=</mo><mi>U</mi><mo>×</mo><mi>I</mi></mrow>
        </math>

        <hr class="stil-hr">

        <h3>Catalog oferte (PDF)</h3>
        <object data="/resurse/documente/Oferte.pdf" type="application/pdf" width="100%" height="400px">
            <p><a href="/resurse/documente/Oferte.pdf" download>Descarca Catalog</a></p>
        </object>
    </section>


    <section id="z5">
        <h3>Tutoriale recomandate</h3>

        <div class="video-tab-container">
            <iframe name="player_video" src="https://www.youtube.com/embed/s1fxZ-VWs2U" width="100%" height="250" title="Tutorial"></iframe>

            <div class="video-links">
                <a href="https://www.youtube.com/embed/gcy-Q99gvw8" target="player_video">Ghid piese</a>
                <a href="https://www.youtube.com/embed/s1fxZ-VWs2U" target="player_video">Asamblare</a>
                <a href="https://www.youtube.com/embed/AkNEvIWp2fM" target="player_video">Test stres</a>
            </div>
        </div>

        <h3>Prezentare FromHardware (Video Nativ)</h3>
        <video poster="/resurse/imagini/poster-video.jpg" controls preload="metadata" class="video-custom">
            <source src="/resurse/video/prezentare.mp4" type="video/mp4">
            <source src="/resurse/video/prezentare.webm" type="video/webm">

            <track kind="captions" src="/resurse/video/ro.vtt" srclang="ro" label="Română" default>
            <track kind="captions" src="/resurse/video/en.vtt" srclang="en" label="English">

            Browserul tău nu suportă elementul video.
        </video>

        <h3>Playlist Video</h3>
        <iframe width="100%" height="250" src="https://www.youtube.com/embed/videoseries?list=PLm-djqjo5wQJM0hPdYJirLNuFZTZMIqhU&autoplay=1&loop=1&controls=1" title="Playlist" allowfullscreen></iframe>
    </section>

    <div id="z6" class="table-container">
        <table>
            <caption>Comparatie componente High-End</caption>
            <thead>
            <tr><th>Componenta</th><th>Model</th><th>Stoc</th><th>Pret (RON)</th></tr>
            </thead>
            <tbody>
            <tr><td rowspan="2">Procesor</td><td>Intel Core i9</td><td>Limitat</td><td>2900</td></tr>
            <tr><td>AMD Ryzen 9</td><td>Disponibil</td><td>3100</td></tr>
            <tr><td>Placa Video</td><td>NVIDIA GeForce RTX 4090</td><td>Disponibil</td><td>9500</td></tr>
            <tr><td>Memorie RAM</td><td>Corsair Vengeance DDR5</td><td>Limitat</td><td>1000</td></tr>
            </tbody>
            <tfoot>
            <tr><td colspan="3">Total estimat:</td><td>16500</td></tr>
            </tfoot>
        </table>
    </div>

    <section id="z7">
        <h3>Harta interactiva</h3>
        <img src="/resurse/imagini/b450.jpg" alt="Placa de baza" usemap="#mapa-hardware" width="250" height="250" />
        <map name="mapa-hardware">
            <area shape="rect" coords="110,65,175,135" href="#z1" alt="Procesoare">
            <area shape="rect" coords="190,15,250,165" href="#z8" alt="RAM">
        </map>
        <p><a href="https://hotnews.ro/" target="_blank">Articol prețuri RAM</a></p>
    </section>

    <article id="z8">
        <h2>Memorie RAM Corsair</h2>
        <figure id="oferta-ram">
            <picture>
                <source srcset="/resurse/imagini/ramddr5-mic.jpg" media="(max-width: 43.75rem)"/>
                <img src="/resurse/imagini/ramddr5-mediu.jpg" alt="RAM Corsair" />
            </picture>
            <figcaption>DDR5 Corsair Vengeance Pro</figcaption>
        </figure>
    </article>
</main>

<%- include('../fragmente/footer') %>
<script src="/resurse/js/tema.js"></script>

</body>
</html>